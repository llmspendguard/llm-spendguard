# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.venv/
.venv
.pyspy-scratch/
venv/
# iCloud-ignored dirs (e.g. .venv.nosync) — keep churny venvs out of iCloud sync
*.nosync
# .archify generated output is excluded from iCloud via .archify.nosync (matched by *.nosync above);
# .archify is a symlink -> .archify.nosync so tooling keeps writing to the .archify path.
/.archify
.pytest_cache/
.mypy_cache/
.ruff_cache/
.test_durations.local.json

# OS
.DS_Store

# spendguard runtime data (never commit spend logs / keys)
.spendguard/
*.env
.env
.env*
*~
.*~
saas.json
email.json
!saas.example.json

# MkDocs build output
site/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# machine-local SaaS connection (org/team/key) — never commit
.spendguard.json
scripts/reconstruct/realtime_find_batch_state.*

# Timestamped backups written by config.update_json before it rewrites a tracked JSON file.
# They are a safety net for the working copy, not history — git already keeps the old version.
*.save.json

# Paid-run artifacts from the reasoning-stress matrix (scripts/integration): each is a local checkpoint of a
# real spend run — the durable copy of those facts is the gate ledger, not repo history.
scripts/integration/reasoning_stress_*.jsonl
scripts/integration/thinking_budget_*.jsonl

# capability_map.py generated outputs (regenerate with the tool)
scripts/probe/capability_map_out/

# Generated ANALYSIS/REVIEW artifacts — regenerable with their tool, not history:
#   .honestreview/  = the honestreview doctrine-graph sqlite (built by `honestreview index`)
#   conformance_runs/ = dated panel-review JSON outputs
#   scripts/reliability/*.json = reconstructed forensic error-logs (the durable copy is the gate ledger)
.honestreview/
conformance_runs/
scripts/reliability/*.json

# Dated deferral audits swept from the WHOLE estate, not from this repo. Their register mixes four
# unrelated sources — this repo's source defects, memory/feedback files, git-blame carryover, and
# personal/clinical obligations — so the file carries private absolute paths and third-party health
# information that must never reach a PUBLIC repo. Keep the sweep local; the repo-scoped rows belong
# in a repo-scoped register instead. See docs/DEFERRAL_REGISTER.md.
/DEFERRAL_AUDIT_*.md
