    {
      "id": "openssf-scorecard",
      "description": "OpenSSF Scorecard mapping.",
      "standard": "https://scorecard.dev/",
      "gate": "spendguard.external_standard_readiness:assess_external_standard_subset",
      "reason": "Reviewed offline subset only; no external certification claimed.",
      "arguments": {
        "kind": "scorecard",
        "policy": {
          "required_files": [
            "LICENSE",
            "SECURITY.md"
          ],
          "workflows": ".github/workflows/*.yml",
          "safe_run_expressions": [
            "steps.python.outputs.python-path",
            "matrix.shard-index",
            "matrix.python-version"
          ],
          "binary_suffixes": [
            ".whl",
            ".exe",
            ".dll",
            ".so",
            ".dylib",
            ".pyc",
            ".class",
            ".jar",
            ".zip",
            ".tar",
            ".gz"
          ],
          "binary_waivers": [
            {
              "path": "src/spendguard/distribution_build_wheels/setuptools-84.2.1-py3-none-any.whl",
              "sha256": "ca140b45d5325a9478f880e351484f62fef15f336462e449ca0c03c873d589c2",
              "version": "84.2.1",
              "document": "docs/WAIVERS.md"
            }
          ],
          "waiver_metadata_suffix": ".dist-info/METADATA",
          "wheel_metadata_depth": 2
        },
        "reviews": [
          {
            "id": "License / Security-Policy",
            "disposition": "GATED-OFFLINE",
            "reason": "Repository license and security policy files are required.",
            "tracking": "docs/READINESS.md"
          },
          {
            "id": "Token-Permissions",
            "disposition": "GATED-OFFLINE",
            "reason": "Every workflow defaults to contents: read and no workflow-wide write grants.",
            "tracking": "docs/READINESS.md"
          },
          {
            "id": "Dangerous-Workflow subset",
            "disposition": "GATED-OFFLINE",
            "reason": "Reject pull_request_target and unreviewed inline run expressions. The three permitted expressions are trusted runner output or configured numeric/version matrix data.",
            "tracking": "docs/READINESS.md"
          },
          {
            "id": "Pinned-Dependencies Actions subset",
            "disposition": "GATED-OFFLINE",
            "reason": "All remote Actions references require immutable 40-hex commits.",
            "tracking": "docs/READINESS.md"
          },
          {
            "id": "Binary-Artifacts",
            "disposition": "REVIEWED-EXCEPTION",
            "reason": "The vendored setuptools backend is a real binary-artifact finding; enforce the exact reviewed wheel SHA256, not a Scorecard pass.",
            "tracking": "docs/WAIVERS.md"
          },
          {
            "id": "Pinned-Dependencies remaining ecosystems",
            "disposition": "REVIEWED-N/A",
            "reason": "Full dependency pin coverage requires the Scorecard runner; this gate checks Actions only.",
            "tracking": "docs/READINESS-FOLLOWUP.md"
          },
          {
            "id": "Branch-Protection / Code-Review / Maintained / CI-Tests / Vulnerabilities / Fuzzing / Signed-Releases / Dependency-Update-Tool / CII-Best-Practices / Contributors / Packaging / SAST / Webhooks / License recognition",
            "disposition": "REVIEWED-N/A",
            "reason": "Requires live GitHub API, OSV, Scorecard runner, or external service state; file presence is not a score for these checks.",
            "tracking": "docs/READINESS-FOLLOWUP.md"
          }
        ]
      }
    },
