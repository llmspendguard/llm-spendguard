      "description": "Current source passes required checks in independent clean environments.",
      "gate": "spendguard.capability_readiness_gates:assess_capability_environment_evidence",
      "arguments": {
        "patterns": [
          "src/spendguard/**/*.py",
          "src/spendguard/capability*.json",
          "src/spendguard/capability*.jsonl",
          "scripts/test/*.py",
          "tests/**/*.py",
          "pyproject.toml",
          ".github/workflows/*.yml",
          "docs/*.md",
          "LICENSE",
          "SECURITY.md",
          "CONTRIBUTING.md",
          "README.md",
          "CHANGELOG.md",
          "src/spendguard/distribution_build_wheels/*.whl"
        ],
        "required_checks": [
          "ruff",
          "name-uniqueness",
          "surface-suites",
          "offline-audit"
        ]
      }
