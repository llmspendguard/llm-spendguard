    {
      "id": "pypa-packaging",
      "description": "PyPA packaging standards mapping.",
      "standard": "https://packaging.python.org/en/latest/tutorials/packaging-projects/",
      "gate": "spendguard.external_standard_readiness:assess_external_standard_subset",
      "reason": "Reviewed offline subset only; no external certification claimed.",
      "arguments": {
        "kind": "packaging",
        "policy": {
          "source_directory": "source",
          "artifact_directory": "artifacts",
          "venv_directory": "installed",
          "venv_python": "bin/python",
          "venv_command": "bin/spendguard",
          "artifact_suffixes": [
            ".gz",
            ".whl"
          ],
          "wheel_suffix": ".whl",
          "metadata_suffix": ".dist-info/METADATA",
          "metadata_fields": [
            "Name",
            "Version",
            "Summary",
            "Description-Content-Type",
            "License",
            "Requires-Python",
            "Classifier",
            "Project-URL"
          ],
          "environment": {
            "PIP_NO_INDEX": "1",
            "PIP_DISABLE_PIP_VERSION_CHECK": "1"
          },
          "runtime_dependency": "psutil",
          "site_probe": "import sysconfig; print(sysconfig.get_path('purelib'))",
          "import_probe": "import spendguard; from importlib.metadata import version; assert spendguard.__version__ == version('llm-spendguard')"
        },
        "reviews": [
          {
            "id": "Build / metadata / installed behavior",
            "disposition": "GATED-OFFLINE",
            "reason": "Build sdist and wheel offline with shipped backend provisioning; twine strict-check both; require core metadata/readme; import and version from a fresh venv with offline runtime dependency copied from this interpreter.",
