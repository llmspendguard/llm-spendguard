          },
          {
            "id": "Publishing / index acceptance",
            "disposition": "REVIEWED-N/A",
            "reason": "PyPI credentials, network upload and index policy are external to offline artifact validity.",
            "tracking": "docs/READINESS-FOLLOWUP.md"
